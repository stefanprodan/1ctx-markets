# Copy to scripts/staging.env (git-ignored) and fill in. Sourced by
# scripts/staging.sh, which always adds --source bvb and
# --data ~/.1ctx-markets.
STAGING_SSH=staging                   # ssh alias or user@host of the staging Mac
STAGING_LISTEN=127.0.0.1:11238        # the address the service listens on
STAGING_FLAGS=                        # extra server flags, never --data
