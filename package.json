{
  "name": "1ctx-markets",
  "version": "0.0.0-dev",
  "description": "A self-hosted market data server for AI agents",
  "type": "module",
  "bin": {
    "1ctx-markets": "./src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test --concurrent --max-concurrency 4 --timeout 20000 test/",
    "lint": "bun biome check --write . && bun check",
    "build": "mkdir -p bin && bun scripts/build.ts && rm -f .*.bun-build",
    "smoke": "scripts/smoke.sh",
    "clean": "rm -rf bin .*.bun-build",
    "staging-deploy": "scripts/staging.sh deploy",
    "staging-status": "scripts/staging.sh status",
    "staging-secrets": "scripts/staging.sh secrets"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@preact/signals": "2.11.4",
    "@types/bun": "1.4.4",
    "lightweight-charts": "5.2.1",
    "nodemailer": "10.3.1",
    "preact": "11.1.1",
    "preact-render-to-string": "6.8.2",
    "swagger-ui-dist": "5.34.1",
    "typescript": "7.0.2"
  }
}
