{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!bin",
      "!*.bun-build",
      "!.idea",
      "!test/fixtures",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  }
}
